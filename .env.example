# 클라우드 PostgreSQL (Supabase / Neon / Vercel Postgres) 연결 URL
# 설정하지 않으면 프로젝트 내장 초기 DB(20240516_slwlab_DB_Backup.sql 변환 데이터 + 로컬 파일 저장소)로 자동 동작하며,
# 설정 시 자동으로 클라우드 PostgreSQL DB와 연동됩니다.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# 세션 암호화 시크릿 키
AUTH_SECRET="graphit-slwlab-secret-key-2026"
